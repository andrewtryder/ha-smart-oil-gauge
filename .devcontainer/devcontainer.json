{
  "name": "Home Assistant Custom Component Development",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}",
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "always"
        }
      }
    }
  },
  "forwardPorts": [
    8123
  ],
  "onCreateCommand": "rm -rf ${containerWorkspaceFolder}/.venv",
  "postCreateCommand": "python -m venv /home/vscode/.venv && /home/vscode/.venv/bin/pip install --upgrade pip && /home/vscode/.venv/bin/pip install -r requirements.txt -r requirements_test.txt && /home/vscode/.venv/bin/pre-commit install"
}
